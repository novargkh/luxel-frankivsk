// Prisma schema for the LUXEL client portal (personal cabinet) project

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

// Tracks an order's progress through the BAS (1C) CommerceML exchange —
// separate from OrderStatus, which is the client-facing fulfillment status.
// NEW: never sent. SENDING: included in the most recent mode=query
// response, waiting for BAS to call mode=success. SENT_TO_BAS: confirmed
// received by BAS. ERROR: either failed a pre-send validation (e.g. no
// matchable client/product) or a SENDING order that never got confirmed
// within the timeout — both are retried on the next exchange cycle.
enum BasExchangeStatus {
  NEW
  SENDING
  SENT_TO_BAS
  ERROR
}

model User {
  id           String   @id @default(cuid())
  // Login is by email or phone. Clients imported from BAS may come
  // without an email, so it is optional.
  email        String?  @unique
  // Empty until an admin issues a password (clients imported from BAS
  // can't log in before that).
  passwordHash String   @default("")
  passwordIssuedAt DateTime?
  name         String
  company      String?
  // Client's own contact phone (distinct from a Shop's delivery-point
  // phone) — used both as order data and as the email+phone fallback key
  // for matching this client to an existing BAS contractor when no basId
  // is set yet.
  phone        String?
  // BAS/1C contractor GUID, once known — filled in by an admin (e.g. after
  // looking it up in BAS) so the exchange can match by stable ID instead
  // of email+phone. Never set automatically; the portal never creates BAS
  // contractors itself.
  basId        String?  @unique
  // ЄДРПОУ / ІПН from BAS.
  taxCode      String?
  // Personal discount off the base price (BAS), in percent. The client
  // never sees it: catalog, cart and orders just show their own price.
  discountPercent Float @default(0)
  // A blocked client can't log in.
  isActive     Boolean  @default(true)
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())

  orders Order[]
  shops  Shop[]
  // Promo codes an admin handed to this client personally.
  promoCodes PromoCode[] @relation("PromoCodeClients")
  returns    ReturnRequest[]
  profileRequests ProfileRequest[]
  clientPrices    ClientPrice[]
}

// A delivery/pickup point that belongs to a client. A client with several
// stores can add each one separately with its own address and geolocation.
model Shop {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  address       String
  contactPerson String?
  phone         String?
  lat           Float?
  lng           Float?
  workingHours  String?
  createdAt     DateTime @default(now())

  orders     Order[]
  routeStops RouteStop[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       Float     @default(0)
  stock       Int       @default(0)
  category    String?
  videoUrl    String?
  isPromo     Boolean   @default(false)
  promoText   String?
  isActive    Boolean   @default(true)
  // Canonical luxel.ua product URL. Set for products that came from the
  // bulk import or the "Оновити з luxel.ua" admin sync — used to avoid
  // re-adding the same product on a later sync. Null for products the
  // admin created by hand.
  sourceUrl   String?   @unique
  // Packaging quantities imported from the wholesale price/packaging CSV
  // (matched to products by article code) — how many units come in one
  // retail pack, and how many packs/units come in one shipping box.
  packQty     Int?
  boxQty      Int?
  // Explicit article/SKU override for the BAS exchange. Falls back to the
  // regex-extracted article from the product name (extractAttributes) when
  // null — see src/lib/onecExchange.ts.
  article     String?
  // Name of the item in BAF (from the BAF nomenclature import); orders go
  // to BAF with this name and the BAF article. The site keeps showing its
  // own name and photos from luxel.ua.
  bafName     String?
  bafSyncedAt DateTime?
  // BAS/1C product GUID, once known — the primary product-matching key for
  // the exchange when set. Filled in by an admin, e.g. via the "BAS ID"
  // import on the products page. Never set automatically.
  basId       String?   @unique
  // Unit of measure for the BAS exchange's <БазоваяЕдиница>. Every product
  // in this catalog is sold by the piece, so this defaults to "шт" rather
  // than requiring it to be filled in for all ~900 products individually.
  unit        String    @default("шт")
  // Full "Всі характеристики" spec table scraped from the product's
  // luxel.ua page ({label: value}), shown via the "Характеристики" button.
  // Null until the admin runs the specs sync.
  specs       Json?
  // Daily stock check against the product's luxel.ua page (see
  // src/lib/stockSync.ts): when it last ran for this product and what the
  // page said ("В наявності", "Немає в наявності", "Не знайдено").
  stockSyncedAt DateTime?
  sourceStatus  String?
  // Manual availability set by an admin for today: "in" | "low" | "out".
  // Wins over the automatic status until the next daily stock check, which
  // clears it. Highlighted in the admin while set.
  stockOverride   String?
  stockOverrideAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images     ProductImage[]
  orderItems OrderItem[]
  promoCodes PromoCode[] @relation("PromoCodeProducts")
  clientPrices ClientPrice[]
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  shopId         String?
  shop           Shop?       @relation(fields: [shopId], references: [id])
  status         OrderStatus @default(NEW)
  comment        String?
  promoCodeId    String?
  promoCode      PromoCode?  @relation(fields: [promoCodeId], references: [id])
  discountAmount Float       @default(0)
  // Set once an admin has downloaded this order into a 1С export and
  // confirmed it's been keyed in there — lets the export screen default to
  // "not yet sent" orders instead of re-exporting everything every time.
  exportedAt     DateTime?
  // Human-readable sequential order number (distinct from the cuid `id`,
  // which is what actually goes out as the stable external <Ид> in the BAS
  // exchange — the number is just for display / the <Номер> element).
  orderNumber    Int               @unique @default(autoincrement())
  paymentMethod  String?
  deliveryMethod String?
  // BAS (1C) CommerceML exchange state — see BasExchangeStatus.
  basStatus      BasExchangeStatus @default(NEW)
  basError       String?
  basSentAt      DateTime?
  basConfirmedAt DateTime?
  createdAt      DateTime          @default(now())

  items          OrderItem[]
  routeStopOrder RouteStopOrder?
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  quantity     Int
  priceAtOrder Float

  returnItems ReturnItem[]
}

// Promo codes for giveaways and promotions. Can be single-use (one code —
// one winner) or reusable up to a limit, with an optional expiry date.
model PromoCode {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType
  value       Float
  usageLimit  Int?
  isActive    Boolean      @default(true)
  expiresAt   DateTime?
  // Shown to clients in "Доступні промокоди" next to the code.
  description String?
  // Whether clients see this code in their cabinet at all. Off = the code
  // works only for whoever was told it (e.g. a giveaway winner).
  showToClients Boolean    @default(false)
  // Admin-facing name ("Premium -20%"); the code is what clients type.
  name        String?
  // Minimum order total (before discount) for the code to apply.
  minTotal    Float?
  // Valid from this date (inclusive); expiresAt = valid through that day.
  startsAt    DateTime?
  // How many orders one client may use the code in (null = no limit).
  perClientLimit Int?
  // Discount applies only to these products and/or categories (category
  // names as in the catalog). Both empty = the whole order.
  products    Product[]    @relation("PromoCodeProducts")
  categories  String[]     @default([])
  createdAt   DateTime     @default(now())

  orders Order[]
  // Clients this code was handed to. Empty = every client (when shown);
  // otherwise only these clients see it and only they can apply it.
  clients User[] @relation("PromoCodeClients")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
}

// A delivery route for a given date, made up of ordered stops.
model Route {
  id        String   @id @default(cuid())
  name      String?
  date      DateTime
  createdAt DateTime @default(now())

  stops RouteStop[]
}

// One physical stop on a route (a shop). Multiple orders for the same shop
// are aggregated into a single stop for the loading list.
model RouteStop {
  id            String  @id @default(cuid())
  routeId       String
  route         Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  position      Int
  shopId        String?
  shop          Shop?   @relation(fields: [shopId], references: [id])
  label         String
  address       String
  contactPerson String?
  phone         String?
  lat           Float?
  lng           Float?

  orders RouteStopOrder[]
}

model RouteStopOrder {
  id          String    @id @default(cuid())
  routeStopId String
  routeStop   RouteStop @relation(fields: [routeStopId], references: [id], onDelete: Cascade)
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
}

enum ReturnStatus {
  NEW
  APPROVED
  REJECTED
  COMPLETED
}

// A client's request to return goods ("Повернення"): positions picked from
// their own orders plus a free-text reason. An admin reviews it.
model ReturnRequest {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason       String
  status       ReturnStatus @default(NEW)
  // Admin's reply shown to the client (e.g. why it was rejected).
  adminComment String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  items ReturnItem[]
}

model ReturnItem {
  id          String        @id @default(cuid())
  returnId    String
  request     ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity    Int
}

// One run of the luxel.ua stock check (daily cron or the admin button).
model StockSyncRun {
  id          String    @id @default(cuid())
  trigger     String    // "cron" | "admin"
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  checked     Int       @default(0)
  changed     Int       @default(0)
  inStock     Int       @default(0)
  outOfStock  Int       @default(0)
  notFound    Int       @default(0)
  failed      Int       @default(0)
  remaining   Int       @default(0)
  priceDiffs  Int       @default(0)
  // Up to ~30 sample lines for the admin ("назва: 20 → 0").
  details     Json?
}

// A client's request to change their contacts or delivery points. Clients
// can't edit that data themselves (it comes from BAS); an admin applies
// the change and closes the request.
model ProfileRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message      String
  status       String   @default("NEW") // NEW | DONE | REJECTED
  adminComment String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// A client's own price for a product, from that client's price list
// exported from BAF. Wins over "base price minus discount".
model ClientPrice {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Float
  updatedAt DateTime @updatedAt

  @@id([userId, productId])
  @@index([productId])
}
