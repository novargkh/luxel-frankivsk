# Copy this file to .env and fill in real values before running the app.

# SQLite for local dev. For production switch provider to "postgresql" in
# prisma/schema.prisma and point this at your Postgres instance
# (e.g. Vercel Postgres, Neon, Supabase, Railway, or a self-hosted DB).
DATABASE_URL="file:./dev.db"

# Generate a real secret for production: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me-in-production-please"

# Base URL of the deployed app (used by NextAuth for callbacks).
NEXTAUTH_URL="http://localhost:3000"
