# Copy this file to .env and fill in real values before running the app.

# SQLite for local dev. For production switch provider to "postgresql" in
# prisma/schema.prisma and point this at your Postgres instance
# (e.g. Vercel Postgres, Neon, Supabase, Railway, or a self-hosted DB).
DATABASE_URL="file:./dev.db"

# Generate a real secret for production: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me-in-production-please"

# Base URL of the deployed app (used by NextAuth for callbacks).
NEXTAUTH_URL="http://localhost:3000"

# BAS (1C) CommerceML exchange endpoint (/1c_exchange.php) — a technical
# login/password pair unrelated to NextAuth, entered into BAS's exchange
# publication settings. See docs/1c-exchange.md.
ONE_C_EXCHANGE_LOGIN="bas_exchange"
ONE_C_EXCHANGE_PASSWORD="generate-a-real-password"
# Optional — reuses NEXTAUTH_SECRET if unset. Only set this separately if
# you want to be able to rotate the exchange session signing key without
# also invalidating every logged-in NextAuth session.
# ONE_C_EXCHANGE_SECRET=""
# Optional — comma-separated IP allowlist for the exchange endpoint. Leave
# unset to allow any IP (still gated by login/password).
# ONE_C_EXCHANGE_ALLOWED_IPS=""
# Optional — defaults used when an order doesn't have its own payment/
# delivery method set yet (checkout doesn't collect these today).
# CML_DEFAULT_PAYMENT_METHOD="Готівка при отриманні"
# CML_DEFAULT_DELIVERY_METHOD="Доставка на адресу магазину"
# Optional — max orders per mode=query response (default 50).
# ONE_C_EXCHANGE_BATCH_SIZE="50"
